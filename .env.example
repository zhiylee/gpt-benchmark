# Change this before exposing the service outside your machine.
ADMIN_KEY=admin

# Optional. Defaults to ./data/benchmark.db
DATABASE_PATH=./data/benchmark.db

# Optional. Origin allowed to embed the page and access the API cross-origin.
# Leave empty to allow only same-origin embedding and API access.
EMBED_ORIGIN=

# Optional. Used by the standalone benchmark script.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
